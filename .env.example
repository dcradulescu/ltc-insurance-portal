# LTC Insurance Portal — portable deployment configuration
# Copy to .env and replace placeholder values. Never commit real secrets.
# Run corepack pnpm config:check before deployment. It checks settings only, not providers.

NODE_ENV=production
PORT=3000
# Optional bind address. Local verification uses 127.0.0.1; blank preserves Node defaults.
HOST=
APP_ID=ltc-insurance-portal
APP_PUBLIC_URL=https://your-domain.example
VITE_PUBLIC_URL=https://your-domain.example
CORS_ORIGINS=https://your-domain.example
VITE_ALLOWED_HOSTS=your-domain.example,localhost,127.0.0.1

# MySQL-compatible database
DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/DATABASE

# Session signing. Use a long random value (64+ characters recommended).
JWT_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET
# Optional legacy owner identifier used by existing DB role logic.
OWNER_OPEN_ID=

# AI — OpenAI-compatible chat-completions API
OPENAI_BASE_URL=https://api.openai.com
OPENAI_API_KEY=REPLACE_ME
OPENAI_MODEL=REPLACE_WITH_MODEL_NAME

# S3-compatible object storage
S3_BUCKET=ltc-portal
S3_REGION=us-east-1
# Leave empty for AWS S3. Set for Cloudflare R2, MinIO, Backblaze B2 S3, etc.
S3_ENDPOINT=
S3_ACCESS_KEY_ID=REPLACE_ME
S3_SECRET_ACCESS_KEY=REPLACE_ME
S3_FORCE_PATH_STYLE=false
# Legacy public CDN setting. Private portal files always use authenticated /storage/* links
# and short-lived signed S3 downloads, regardless of this setting.
S3_PUBLIC_BASE_URL=

# LTC Portal secure outbound email: Paubox Email API.
# Keep receiving the office copies in the current GoDaddy/Microsoft 365 mailbox.
# Before activating, verify scvisitingangels.com with Paubox, configure SPF
# to include BOTH Microsoft 365 and Paubox, enable DKIM and confirm the BAA.
# Never commit an actual API key or put it in browser/client variables.
LTC_MAIL_TRANSPORT=paubox
PAUBOX_API_KEY=
PAUBOX_SENDER_EMAIL=daniel@scvisitingangels.com

# Optional legacy transports (NOT required for Paubox).
# Use only by explicit choice after separate approval.
MS365_TENANT_ID=
MS365_CLIENT_ID=
MS365_CLIENT_SECRET=
MS365_SENDER_EMAIL=

# Anonymous LTC visitor support copies.
LTC_SUPPORT_EMAIL=daniel@scvisitingangels.com
LTC_SUPPORT_COPY_ENABLED=true
NOTIFY_OWNER_EMAIL=daniel@scvisitingangels.com

# Legacy SMTP fallback only if LTC_MAIL_TRANSPORT=smtp. GoDaddy specifies
# smtp.office365.com / port 587 / STARTTLS. Basic SMTP auth is being retired.
# Never disable tenant security defaults merely to enable SMTP.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Optional legacy email/delivery webhook on authenticated routes only.
# Public LTC reports and Contact Us use LTC_MAIL_TRANSPORT (Paubox preferred).
ZAPIER_WEBHOOK_URL=

# Existing optional SMS workflow
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=


# Set to the exact known reverse-proxy hop count only. Direct hosting: leave blank.
TRUST_PROXY_HOPS=
