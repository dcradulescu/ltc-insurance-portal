# LTC Insurance Portal - Hostinger VPS Production Environment
# Copy this file to /var/www/ltc-insurance-portal/shared/.env and fill in real values.
# Never commit the real .env file.

# ------------------------------------------------------------
# Runtime
# ------------------------------------------------------------
NODE_ENV=production
PORT=3000
APP_PUBLIC_URL=https://ltc.example.com

# Optional comma-separated list for additional allowed browser origins.
# Example: ALLOWED_ORIGINS=https://www.ltc.example.com,https://admin.ltc.example.com
ALLOWED_ORIGINS=

# Keep false for independent production hosting.
# Set true only while testing legacy preview domains.
ALLOW_MANUS_ORIGINS=false

# ------------------------------------------------------------
# Security
# ------------------------------------------------------------
# Generate with: openssl rand -base64 48
JWT_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET

# Temporary local admin login for independent VPS hosting.
# Generate the password with: openssl rand -base64 32
LOCAL_AUTH_ENABLED=true
LOCAL_ADMIN_EMAIL=admin@example.com
LOCAL_ADMIN_PASSWORD=REPLACE_WITH_STRONG_RANDOM_PASSWORD
LOCAL_ADMIN_NAME=Portal Administrator

# Temporary legacy admin marker. Remove after fully replacing legacy auth.
OWNER_OPEN_ID=local-admin

# ------------------------------------------------------------
# Database - MySQL/MariaDB
# ------------------------------------------------------------
# Example:
# DATABASE_URL=mysql://ltc_portal_user:strong_password@127.0.0.1:3306/ltc_insurance_portal
DATABASE_URL=mysql://REPLACE_USER:REPLACE_PASSWORD@127.0.0.1:3306/ltc_insurance_portal

# ------------------------------------------------------------
# Legacy compatibility - temporary only
# ------------------------------------------------------------
# These are required only while legacy auth remains in code.
# They should be removed after replacing authentication.
VITE_APP_ID=
OAUTH_SERVER_URL=
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# ------------------------------------------------------------
# Email - SMTP
# ------------------------------------------------------------
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=REPLACE_WITH_SMTP_USER
SMTP_PASS=REPLACE_WITH_SMTP_PASSWORD
SMTP_FROM="LTC Navigator <noreply@example.com>"

# ------------------------------------------------------------
# SMS - Twilio
# ------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ------------------------------------------------------------
# Zapier
# ------------------------------------------------------------
VITE_ZAPIER_WEBHOOK_URL=

# ------------------------------------------------------------
# File storage
# ------------------------------------------------------------
# Current VPS-ready option: local
# Future options: r2, s3
OBJECT_STORAGE_PROVIDER=local
LOCAL_STORAGE_ROOT=/var/www/ltc-insurance-portal/shared/uploads
LOCAL_STORAGE_PUBLIC_BASE_URL=/uploaded-files

# Future object storage settings for Cloudflare R2 or AWS S3.
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
OBJECT_STORAGE_PUBLIC_BASE_URL=
