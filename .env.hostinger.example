# LTC Insurance Portal — Hostinger VPS Production Environment
# Copy this file to /var/www/ltc-insurance-portal/shared/.env and fill in real values.
# Never commit the real .env file.

# ------------------------------------------------------------
# Runtime
# ------------------------------------------------------------
NODE_ENV=production
PORT=3000
APP_PUBLIC_URL=https://ltc.example.com

# ------------------------------------------------------------
# Security
# ------------------------------------------------------------
# Generate with: openssl rand -base64 48
JWT_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET

# This currently exists for Manus compatibility. During Manus decoupling,
# replace OWNER_OPEN_ID with your own admin-user bootstrap mechanism.
OWNER_OPEN_ID=REPLACE_WITH_ADMIN_OPEN_ID_OR_TEMP_VALUE

# ------------------------------------------------------------
# Database — MySQL/MariaDB
# ------------------------------------------------------------
# Example:
# DATABASE_URL=mysql://ltc_portal_user:strong_password@127.0.0.1:3306/ltc_insurance_portal
DATABASE_URL=mysql://REPLACE_USER:REPLACE_PASSWORD@127.0.0.1:3306/ltc_insurance_portal

# ------------------------------------------------------------
# Manus compatibility — temporary only
# ------------------------------------------------------------
# These are required only while legacy Manus auth/storage remains in code.
# They should be removed after replacing auth and storage.
VITE_APP_ID=
OAUTH_SERVER_URL=
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# ------------------------------------------------------------
# Email — SMTP
# ------------------------------------------------------------
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=REPLACE_WITH_SMTP_USER
SMTP_PASS=REPLACE_WITH_SMTP_PASSWORD
SMTP_FROM="LTC Navigator <noreply@example.com>"

# ------------------------------------------------------------
# SMS — Twilio
# ------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ------------------------------------------------------------
# Zapier
# ------------------------------------------------------------
VITE_ZAPIER_WEBHOOK_URL=

# ------------------------------------------------------------
# Future object storage replacement for Manus storage
# ------------------------------------------------------------
# Recommended: Cloudflare R2 or AWS S3.
# These are placeholders for the next implementation pass.
OBJECT_STORAGE_PROVIDER=r2
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
OBJECT_STORAGE_PUBLIC_BASE_URL=
